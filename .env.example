# In .env kopieren und die Platzhalter ersetzen. Die Datei .env wird nicht versioniert.

# Schritt 1: Token für die Firmenbuch-Schnittstelle (JustizOnline, Informationsweiterverwendung)
HVD_API_KEY=API_KEY_EINSETZEN

# Stufen 2 und 3: Azure OpenAI
AZURE_OPENAI_API_KEY=API_KEY_EINSETZEN
AZURE_OPENAI_ENDPOINT=https://RESSOURCE.cognitiveservices.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT=DEPLOYMENT_NAME_EINSETZEN
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=DEPLOYMENT_NAME_EINSETZEN

# Stufe 1: Ollama
OLLAMA_HOST=http://localhost:11434
